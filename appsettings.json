{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5233"
            }
        }
    },

    "ConnectionStrings": {
        "MongoDb": "mongodb://localhost:27017/russiabasket"
    },

  "AppSettings": {
    "TelegramBotToken": "",
    "TelegramProxyUrl": "http://127.0.0.1:8877", // e.g. "http://user:pass@proxy-host:8080" or "socks5://proxy-host:1080"

    "Hangfire": {
      "ServerName": "server", // override for any environment
      "DashboardUrl": "/hangfire",
      "Queues": [ "default" ]
    }
  },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 10
                }
            }
        ],
        "Enrich": [ "FromLogContext" ],
        "Properties": {
            "Application": "RussiaBasketBot"
        }
    }
}